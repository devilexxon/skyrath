<?xml version="1.0" encoding="utf-8"?>
<!-- App ID, version and SDK levels are set in app/build.gradle (and android/version.properties). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The game itself is offline; the internet permission lets the built-in web view start and lets
         Google Play Games keep a cloud copy of the save when the player is signed in. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:label="Skyrath"
        android:icon="@mipmap/ic_launcher"
        android:hardwareAccelerated="true"
        android:allowBackup="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@android:style/Theme.NoTitleBar.Fullscreen">

        <!-- Google Play Games project ID (from Play Console -> Play Games Services). Empty = cloud save off. -->
        <meta-data
            android:name="com.google.android.gms.games.APP_ID"
            android:value="@string/game_services_project_id" />

        <!-- AdMob app ID (required by the ads SDK) -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="@string/admob_app_id" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard|navigation">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
